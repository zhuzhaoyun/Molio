{
  "name": "knowledge-growth-engine",
  "version": "0.1.0",
  "description": "Knowledge Growth Engine - AI writing platform with local runtime orchestration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @kge/daemon dev\" \"pnpm --filter @kge/web dev\" --names daemon,web --prefix-colors auto",
    "dev:daemon": "pnpm --filter @kge/daemon dev",
    "dev:web": "pnpm --filter @kge/web dev",
    "dev:desktop": "concurrently \"pnpm --filter @kge/daemon dev\" \"pnpm --filter @kge/web dev\" \"pnpm --filter @kge/desktop dev\" --names daemon,web,desktop --prefix-colors auto",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @kge/desktop build",
    "package": "pnpm build && pnpm --filter @kge/desktop package",
    "package:dir": "pnpm build && pnpm --filter @kge/desktop package:dir",
    "desktop:run": "pnpm build && pnpm --filter @kge/desktop run:unpacked",
    "test": "pnpm --filter @kge/daemon test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.1",
    "typescript": "^5.8.3"
  }
}
