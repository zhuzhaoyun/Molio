{
  "name": "@molio/cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc && node --test --test-timeout=30000 \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/dm20151123": "^1.10.2",
    "@alicloud/openapi-core": "^1.0.8",
    "@darabonba/typescript": "^1.0.5",
    "@hono/node-server": "^1.13.0",
    "@molio/contracts": "workspace:*",
    "hono": "^4.7.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
