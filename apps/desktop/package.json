{
  "name": "@kge/desktop",
  "version": "0.1.0",
  "description": "Molio - AI writing & knowledge management platform",
  "author": "Molio Team",
  "type": "module",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "prepare": "node scripts/prepare-resources.mjs",
    "build": "pnpm --filter @kge/contracts build && pnpm --filter @kge/daemon build && pnpm --filter @kge/web build && node scripts/prepare-resources.mjs",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --win --dir",
    "run:unpacked": "electron-builder --win --dir && echo 'Run: ./dist/win-unpacked/墨流 Molio.exe'",
    "typecheck": "echo 'desktop: no TS to check'"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.kge.desktop",
    "productName": "Molio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-windows.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "zhuzhaoyun",
      "repo": "Molio",
      "releaseType": "release"
    }
  }
}
