# ============================================================
# Molio Docker 部署环境变量
# 复制此文件为 .env 并填写实际值：cp .env.example .env
# ============================================================

# [必填] Anthropic API Key — Claude Code 对话所需
# 获取方式：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# [可选] 知识库文档在 NAS 上的路径
# 该目录会被挂载到容器内的 /vaults
# 在 Molio Web UI 创建知识库时，路径填 /vaults/你的文件夹名
#
# 群晖 NAS 示例：/volume1/docker/molio/vaults
# 威联通 NAS 示例：/share/Container/molio/vaults
# 普通 Linux 示例：/opt/molio/vaults
#
# 不设置时默认使用 ./vaults（docker-compose.yml 所在目录下的 vaults 文件夹）
MOLIO_VAULT_PATH=/volume1/docker/molio/vaults

# [可选] Web 访问端口（默认 3100）
# 如果 3100 端口被占用，可以改成其他端口
# MOLIO_PORT=3100
