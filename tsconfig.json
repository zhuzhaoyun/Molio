{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/daemon/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "prototype"]
}
