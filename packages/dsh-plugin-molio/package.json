{
  "name": "dsh-plugin-molio",
  "version": "0.2.4",
  "description": "Obsidian 与本地知识库插件 for DeepSeek Harness — 在 DSH 侧栏原生打开 Obsidian Vault、关系图谱与双链属性预览，让 AI 基于你的笔记问答与沉淀（Powered by Molio）",
  "type": "module",
  "main": "dist/host/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/host/index.mjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js"
  },
  "files": [
    "dist/host",
    "dist/src",
    "dist/service",
    "dist/web",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "obsidian",
    "obsidian-vault",
    "wikilink",
    "markdown",
    "knowledge-base",
    "knowledge-graph",
    "second-brain",
    "molio"
  ],
  "homepage": "https://github.com/zhuzhaoyun/Molio/tree/main/packages/dsh-plugin-molio",
  "bugs": {
    "url": "https://github.com/zhuzhaoyun/Molio/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuzhaoyun/Molio.git",
    "directory": "packages/dsh-plugin-molio"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/build-dsh-plugin.mjs",
    "test": "tsc && node --test --test-timeout=30000 \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@molio/contracts": "workspace:*",
    "yaml": "^2.9.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "dependencies": {
    "trash": "^10.1.1"
  }
}
